h3 Quick Commands

.form-line.mb-3
    .header
        .title Show full command in menu
        .description ON: show full command as subtitle under the name. OFF: hide the full command.
    toggle(
        [ngModel]='showFullCommand',
        (ngModelChange)='onShowFullCommandChange($event)',
    )

.form-group
    button.btn.btn-sm.btn-outline-primary.mb-2((click)='createCommand()')
        i.fa.fa-fw.fa-globe
        span.ml-2 Add command
    input.form-control.quickCmd(
        type='text',
        [(ngModel)]='quickCmd',
        autofocus,
        placeholder='enter to filter',
        (ngModelChange)='refresh()',
        (keyup.esc)='cancelFilter()'
    )
p.text-muted.small Drag the grip to reorder groups or commands within a group. Clear the filter to enable sorting.
.list-group.mt-3.mb-3
    ng-container(*ngFor='let group of childGroups')
        .list-group-item.list-group-item-action.d-flex.align-items-center.qc-row((click)='groupCollapsed[group.name] = !groupCollapsed[group.name]', (dragover)='allowGroupDrop($event)', (drop)='dropGroup($event, group)')
            span.drag-handle.mr-2([draggable]='!quickCmd', [class.disabled]='!!quickCmd', (dragstart)='startGroupDrag($event, group)', (dragend)='endDrag()', (click)='$event.stopPropagation()', title='Drag to reorder group', aria-label='Drag to reorder group')
                i.fa.fa-grip-vertical
            .fa.fa-fw.fa-chevron-right(*ngIf='groupCollapsed[group.name]')
            .fa.fa-fw.fa-chevron-down(*ngIf='!groupCollapsed[group.name]')
            span.ml-3.mr-auto {{group.name || "Ungrouped"}}
            .command-actions((click)='$event.stopPropagation()')
                .visibility-control
                    span.text-muted Hidden
                    toggle([ngModel]='group.hidden === true', (ngModelChange)='setGroupHidden(group, $event)', aria-label='Hide group from quick selection')
                .command-buttons
                    button.btn.btn-sm.btn-outline-info((click)='editGroup(group)', title='Edit group')
                        i.fa.fa-pencil
                    button.btn.btn-sm.btn-outline-danger((click)='deleteGroup(group)', title='Delete group')
                        i.fa.fa-trash-can
        ng-container(*ngIf='!groupCollapsed[group.name]')
            .list-group-item.pl-5.d-flex.align-items-center.qc-row(*ngFor='let cmd of group.cmds', (dragover)='allowCommandDrop($event, cmd)', (drop)='dropCommand($event, cmd)')
                span.drag-handle.mr-2([draggable]='!quickCmd', [class.disabled]='!!quickCmd', (dragstart)='startCommandDrag($event, cmd)', (dragend)='endDrag()', title='Drag to reorder command', aria-label='Drag to reorder command')
                    i.fa.fa-grip-vertical
                .mr-auto.command-content
                    div {{cmd.name}}
                    .text-muted
                        span {{cmd.text}}
                        span.ml-1(*ngIf='cmd.appendCR', title='Appends CR') ↵
                        span.badge.bg-secondary.ml-2(*ngIf='cmd.profileIds?.length') SSH
                .command-actions
                    .visibility-control
                        span.text-muted Hidden
                        toggle([ngModel]='cmd.hidden === true', (ngModelChange)='setCommandHidden(cmd, $event)', aria-label='Hide command from quick selection')
                    .command-buttons
                        button.btn.btn-sm.btn-outline-info((click)='editCommand(cmd)', title='Edit command')
                            i.fa.fa-pencil
                        button.btn.btn-sm.btn-outline-danger((click)='deleteCommand(cmd)', title='Delete command')
                            i.fa.fa-trash-can
